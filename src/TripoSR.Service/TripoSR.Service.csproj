<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>triposr-service</AssemblyName>
    <RootNamespace>TripoSR.Service</RootNamespace>
    <!-- Allows running on machines that only have a newer runtime (e.g. .NET 10). -->
    <RollForward>Major</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TripoSR.Net\TripoSR.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The API description and the documentation page (with Swagger UI, Apache-2.0) are inside the executable, so it needs no files beside it. -->
    <EmbeddedResource Include="openapi.yaml" LogicalName="openapi.yaml" />
    <EmbeddedResource Include="Docs\**\*" LogicalName="docs/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TripoSR.Net.Tests" />
  </ItemGroup>

</Project>
